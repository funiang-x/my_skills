{
    // ========================================================================
    //  IntelliSense / 跳转 / 补全 配置
    //
    //  策略：以构建系统产出的 compile_commands.json 为**唯一事实来源**，
    //  includePath / defines 只作为兜底 —— 这样新增文件、改 include 目录后
    //  不会再出现"能编译但 IDE 全红波浪线"的经典错位。
    //
    //  ⚠️ 首次使用前先跑一次配置，生成 build/Debug/compile_commands.json：
    //         cmake --preset Debug
    //     或在 VS Code 里执行任务「① 配置 CMake (Debug)」。
    //
    //  ⚠️ 下面的 defines / includePath 是**兜底**，不参与真实构建。
    //     真实构建的 include 路径由 CMake 的 target 决定（见 CMakeLists.txt）——
    //     比如 `operation` 目标**故意**拿不到 HAL 头（规矩 2 的机器强制）。
    //     所以 IDE 里看到"Operation 能跳转到 HAL"并不代表它编得过。
    // ========================================================================
    "version": 4,
    "configurations": [
        {
            "name": "<CHIP_MODEL> (arm-none-eabi)",
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
            // 换机器/换工具链版本时改这里；也可直接用 PATH 里的 arm-none-eabi-gcc。
            "compilerPath": "C:/Program Files/Compiler/arm-gnu-toolchain-15.2.rel1-mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-arm",
            "defines": [
                "USE_HAL_DRIVER",
                // ⚠️ 换芯片清单 ③：CMSIS 器件宏。与 CMakeLists.txt 的 freertos_headers
                //    和 cmake/stm32cubemx/CMakeLists.txt 的 MX_Defines_Syms 三处同步改。
                "STM32F407xx",
                "LOG_BACKEND_RTT"
            ],
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/Task/Inc",
                "${workspaceFolder}/Operation/Inc",
                "${workspaceFolder}/Device/Inc",
                "${workspaceFolder}/Common/Inc",
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Test",
                "${workspaceFolder}/Drivers/STM32F4xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/STM32F4xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F4xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Include",
                "${workspaceFolder}/Middlewares/RTT",
                "${workspaceFolder}/Middlewares/Third_Party/FreeRTOS/Source/include",
                "${workspaceFolder}/Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS_V2",
                "${workspaceFolder}/Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM4F"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/Task",
                    "${workspaceFolder}/Operation",
                    "${workspaceFolder}/Device",
                    "${workspaceFolder}/Common",
                    "${workspaceFolder}/Core",
                    "${workspaceFolder}/Test"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ]
}
